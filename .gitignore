node_modules/
*.sqlite
# SQLite sidecars: opening a rig database creates them, and a -wal can hold
# committed transactions that are not yet checkpointed, so they must never be
# committed and never deleted while a database might be open.
*.sqlite-wal
*.sqlite-shm
durig.config.json
# Machine-local pi agent state: a local-model endpoint (and its key) can land
# here, so it is host-specific like durig.config.json and never committed.
.pi/
.durig/
# built upstream tree, reproducible from pi-main.pin.json
vendor/pi-main/
# vendored warden build tree: not imported anywhere in this repo (same policy as vendor/pi-main)
vendor/pi-warden/
# reference clones for TUI research (width, sanitising, rendering patterns); never imported or built,
# so they must never enter the tree's history (see docs/TUI-IMPLEMENTATION-PLAN.md §E)
vendor/eval/
# delegate/seat scratch, recovery patches, and captured logs
.spike/
# Operational exhaust from driving seats: stdout/stderr captures and scratch logs.
.impl.log
.*.out
.*.err
impl-*.out
impl-*.err
pm-*.out
pm-*.err
# Generated rig state: stale database backups, the broker's log/state, and generation leases.
*.sqlite.bak-*
*.sqlite-wal.bak-*
*.sqlite-shm.bak-*
# The broker's WHOLE exhaust family beside the store: its log, state json, AUDIT LOG, stop marker,
# and the inbox spool dirs. A FAMILY pattern rather than a per-name list: the per-name list missed
# `.audit.log`, so `git check-ignore` said NOT ignored and the shared root could never be durably
# clean - the broker writes it continuously, so an "empty status" preflight was unpassable by
# construction (the unreachable-green failure in a new place, #4139).
*.sqlite.broker.*
*.sqlite.genlock.*
# Per-item seat worktrees (`prepare_workspace` puts them at <root>/item-<id>`).
# They are disposable checkouts whose work is committed to a branch, so they must
# never show up as untracked tree dirt (the item-1/item-2 leak, 2026-10-16).
/item-*/
# Worktree/scratch paths durig generates that are NOT created through
# `createWorktree` (raw `git worktree add` for verify scratch, the broker's result
# channel, the lifecycle-test fixture, the lander's scratch). Ignore them here so
# they never leak into `git status` as `?? <dir>/` (WORKTREE-ROT 1/3, #2328).
# Every pattern is DIRECTORY-anchored (`/name/`), so a FILE of a similar name —
# a real qa probe like `verify-1923-pause-edge.mjs` — stays visible.
/verify*/
/.verify-*/
/wt-*/
/.durig-test-wt-*/
/.land-scratch-*/
# The broker's result channel beside the store (`<db>.broker.inbox.out/`); the
# spool dirs above are already ignored, this is the `.out` sibling.
*.sqlite.broker.inbox.out/
nul
